{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  // Web principal de Pyraxis. Publicar: `npx wrangler deploy` en esta carpeta.
  // La página de la alianza vive en /impulsatumarca (carpeta impulsatumarca/, copiada de su generador).
  "name": "pyraxis-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": ".", "binding": "ASSETS", "html_handling": "drop-trailing-slash", "not_found_handling": "404-page", "run_worker_first": true }
}
