{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/impulsatumarca", "destination": "https://pyraxis-impulsa.vercel.app/" },
    { "source": "/impulsatumarca/:path*", "destination": "https://pyraxis-impulsa.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
